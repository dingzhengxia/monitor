{
  "app_settings": {
    "exchange": "binance",
    "default_market_type": "swap",
    "check_interval_minutes": 5,
    "log_level": "DEBUG",
    "max_workers": 2
  },
  "market_settings": {
    "timeframes": [
      "1h",
      "4h",
      "1d"
    ],
    "static_symbols": [
      "BTC",
      "ETH",
      "BNB"
    ],
    "dynamic_scan": {
      "enabled": false,
      "top_n_for_signals": 100,
      "primary_quote_currency": "USDT",
      "cross_market_filter": {
        "enabled": true,
        "must_exist_in": [
          "USDC"
        ]
      },
      "exclude_symbols": [
        "USDT",
        "USD1",
        "USDS",
        "USDC",
        "DAI",
        "TUSD",
        "BUSD",
        "FDUSD",
        "PAXG",
        "USDP",
        "GUSD",
        "USDD",
        "EUROC"
      ]
    }
  },
  "strategy_params": {
    "trend_ema": {
      "long_period": 120
    },
    "dynamic_volume_multipliers": {
      "enabled": true,
      "method": "linear_stepped",
      "min_multiplier": 1.5,
      "max_multiplier": 5.0,
      "apply_to_rank_n": 100,
      "rank_step_size": 3
    },
    "dynamic_atr_multipliers": {
      "enabled": false,
      "method": "linear_stepped",
      "min_multiplier": 1.5,
      "max_multiplier": 5.0,
      "apply_to_rank_n": 100,
      "rank_step_size": 3
    },
    "trend_ema_short": {
      "fast": 12,
      "medium": 26,
      "long": 60
    },
    "trend_ema_long": {
      "fast": 26,
      "medium": 50,
      "long": 120
    },
    "ma_breakout": {
      "enabled": true,
      "ma_type": "sma",
      "ma_periods": [
        7,
        25,
        99
      ],
      "volume_confirm": true,
      "exempt_static_on_volume": false,
      "volume_multiplier": 1.5,
      "exclude_timeframes": []
    },
    "ema_cross": {
      "enabled": true,
      "period": 120,
      "volume_confirm": true,
      "exempt_static_on_volume": true,
      "volume_multiplier": 2,
      "atr_period": 14,
      "atr_multiplier": 1,
      "exclude_timeframes": []
    },
    "kdj_cross": {
      "enabled": false,
      "fast_k": 9,
      "slow_k": 3,
      "slow_d": 3,
      "volume_confirm": true,
      "exempt_static_on_volume": false,
      "volume_multiplier": 2,
      "exclude_timeframes": [
        "1d"
      ]
    },
    "volatility_breakout": {
      "enabled": false,
      "atr_period": 14,
      "atr_multiplier": 2.5,
      "volume_confirm": true,
      "exempt_static_on_volume": false,
      "volume_multiplier": 2.0,
      "exclude_timeframes": []
    },
    "level_breakout": {
      "enabled": true,
      "volume_confirm": false,
      "exempt_static_on_volume": true,
      "volume_multiplier": 1.5,
      "level_detection": {
        "method": "advanced",
        "swing_pivots": {
          "enabled": true,
          "left_bars": 7,
          "right_bars": 7
        },
        "rolling_pivots": {
          "enabled": true
        }
      },
      "breakout_period": 120,
      "volume_ma_period": 20,
      "atr_period": 14,
      "atr_multiplier_breakout": 0.5,
      "exclude_timeframes": [],
      "overrides_by_timeframe": {
        "1d": {
          "level_detection": {
            "method": "advanced",
            "swing_pivots": {
              "enabled": true,
              "left_bars": 10,
              "right_bars": 10
            }
          }
        }
      }
    },
    "rsi_divergence": {
      "enabled": false,
      "rsi_period": 14,
      "lookback_period": 60,
      "exclude_timeframes": [
        "1h"
      ]
    },
    "ob_luxalgo": {
      "enabled": true,
      "swing_length": 5,
      "alert_on_rejection": true,
      "alert_on_breakout": true,
      "exclude_timeframes": []
    },
    "ob_fluxcharts": {
      "enabled": true,
      "swing_length": 10,
      "atr_multiplier": 3.5,
      "alert_on_rejection": true,
      "alert_on_breakout": true,
      "exclude_timeframes": []
    },
    "high_funding_rate": {
      "enabled": true,
      "threshold": 0.01,
      "cooldown_mult": 2,
      "scan_top_n": 500,
      "exclude_timeframes": [
        "15m",
        "1h",
        "1d"
      ]
    },
    "trend_channel_breakout": [
      {
        "name": "短期趋势通道 (1h/4h)",
        "enabled": true,
        "min_trend_length": 10,
        "std_dev_multiplier": 1.2,
        "breakout_confirmation_atr": 0.1,
        "volume_confirm": false,
        "exempt_static_on_volume": true,
        "volume_multiplier": 1.5,
        "exclude_timeframes": [
          "1d"
        ],
        "overrides_by_timeframe": {
          "1h": {
            "lookback_period": 120
          },
          "4h": {
            "lookback_period": 80
          }
        }
      },
      {
        "name": "长期趋势通道 (All TFs)",
        "enabled": true,
        "min_trend_length": 20,
        "std_dev_multiplier": 1.8,
        "breakout_confirmation_atr": 0.2,
        "volume_confirm": false,
        "exempt_static_on_volume": true,
        "volume_multiplier": 2.0,
        "exclude_timeframes": [],
        "overrides_by_timeframe": {
          "1h": {
            "lookback_period": 300
          },
          "4h": {
            "lookback_period": 200
          },
          "1d": {
            "lookback_period": 150
          }
        }
      }
    ],
    "consecutive_candles": {
      "enabled": true,
      "dynamic_count": {
        "enabled": true,
        "method": "linear_stepped",
        "min_count": 6,
        "max_count": 12,
        "apply_to_rank_n": 100,
        "rank_step_size": 10,
        "default_count": 9
      },
      "min_consecutive_candles": 4,
      "volume_confirm": false,
      "exempt_static_on_volume": true,
      "volume_multiplier": 1.5,
      "exclude_timeframes": [
        "15m"
      ]
    }
  },
  "periodic_reports": [
    {
      "enabled": false,
      "report_name": "4小时热点报告",
      "run_interval": "4h",
      "top_n_by_volume": 300,
      "top_n_gainers": 10,
      "min_consecutive_candles": 5,
      "volume_ma_period": 20,
      "top_n_volume_ratio": 10,
      "market_sentiment": {
        "enabled": true,
        "rsi_period": 14,
        "rsi_overbought": 70,
        "rsi_oversold": 30
      }
    },
    {
      "enabled": false,
      "report_name": "每日宏观复盘",
      "run_interval": "1d",
      "top_n_by_volume": 300,
      "top_n_gainers": 10,
      "min_consecutive_candles": 3,
      "volume_ma_period": 20,
      "top_n_volume_ratio": 10,
      "market_sentiment": {
        "enabled": true,
        "rsi_period": 14,
        "rsi_overbought": 75,
        "rsi_oversold": 25
      }
    }
  ],
  "notification_settings": {
    "dingtalk": {
      "enabled": true
    },
    "desktop": {
      "enabled": false,
      "timeout_seconds": 30
    }
  },
  "position_protection": {
    "enabled": true,
    "timeframe": "8h",
    "n1_bars": 7,
    "n2_bars": 26,
    "n3_bars": 83,
    "tier1_ratio": 0.2,
    "tier2_ratio": 0.3,
    "ma_atr_period": 14,
    "ma_atr_buffer_multiplier": 0.3,
    "recovery_atr_buffer_multiplier": 0.3,
    "add_immunity_mode": "until_current_candle_close",
    "emergency_enabled": true,
    "emergency_timeframe": "2h",
    "emergency_atr_period": 14,
    "emergency_atr_multiplier": 8.0,
    "emergency_vol_multiplier": 5.0,
    "emergency_structure_lookback": 4,
    "exchange_hard_stop_enabled": true,
    "hard_stop_timeframe": "8h",
    "hard_stop_atr_period": 14,
    "hard_stop_min_distance_pct": 0.05,
    "hard_stop_atr_multiplier": 3.0,
    "api_max_concurrency": 4,
    "api_max_retries": 5,
    "api_failure_threshold": 5,
    "api_circuit_breaker_cooldown_sec": 30,
    "api_min_interval_sec": 0.06,
    "ws_stale_sec": 45.0,
    "safe_mode_enabled": true,
    "stop_mode": "ema_structure_atr",
    "state_schema_version": 3,
    "ema_fast_period": 26,
    "ema_slow_period": 83,
    "structure_lookback": 12,
    "structure_buffer_atr": 0.5,
    "t1_structure_lookback": 8,
    "t2_structure_lookback": 12,
    "t2_atr_confirmation": 0.5,
    "t3_structure_lookback": 20,
    "t3_ema_confirm_bars": 1,
    "dynamic_stop_atr_multiplier": 1.5,
    "dynamic_stop_max_distance_pct": 0.12,
    "auto_reset_state_on_add": true,
    "entry_classification_enabled": true,
    "entry_classification_lookback_bars": 500,
    "entry_t3_atr_multiplier": 3.0,
    "entry_time_fallback_to_first_seen": true,
    "positions_cache_ttl_sec": 5.0,
    "ticker_cache_ttl_sec": 3.0,
    "orders_cache_ttl_sec": 10.0,
    "ohlcv_cache_ttl_sec": 30.0,
    "position_watch_interval_sec": 5.0,
    "stop_maintenance_interval_sec": 60.0,
    "take_profit_enabled": true,
    "tp1_r_multiple": 1.0,
    "tp2_r_multiple": 2.0,
    "tp3_r_multiple": 3.0,
    "tp1_ratio": 0.2,
    "tp2_ratio": 0.3,
    "tp3_close_all": true,
    "tp_breakeven_buffer_pct": 0.002,
    "tp_profit_lock_buffer_pct": 0.001,
    "tp_use_closed_candle": false
  }
}