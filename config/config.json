{
  "app_settings": {
    "exchange": "binance",
    "default_market_type": "swap",
    "check_interval_minutes": 5,
    "log_level": "DEBUG",
    "max_workers": 2
  },
  "market_settings": {
    "timeframes": [
      "1h",
      "4h",
      "1d"
    ],
    "static_symbols": [
      "BTC",
      "ETH",
      "BNB"
    ],
    "dynamic_scan": {
      "enabled": false,
      "top_n_for_signals": 100,
      "primary_quote_currency": "USDT",
      "cross_market_filter": {
        "enabled": true,
        "must_exist_in": [
          "USDC"
        ]
      },
      "exclude_symbols": [
        "USDT",
        "USD1",
        "USDS",
        "USDC",
        "DAI",
        "TUSD",
        "BUSD",
        "FDUSD",
        "PAXG",
        "USDP",
        "GUSD",
        "USDD",
        "EUROC"
      ]
    }
  },
  "strategy_params": {
    "trend_ema": {
      "long_period": 120
    },
    "dynamic_volume_multipliers": {
      "enabled": true,
      "method": "linear_stepped",
      "min_multiplier": 1.5,
      "max_multiplier": 5.0,
      "apply_to_rank_n": 100,
      "rank_step_size": 3
    },
    "dynamic_atr_multipliers": {
      "enabled": false,
      "method": "linear_stepped",
      "min_multiplier": 1.5,
      "max_multiplier": 5.0,
      "apply_to_rank_n": 100,
      "rank_step_size": 3
    },
    "trend_ema_short": {
      "fast": 12,
      "medium": 26,
      "long": 60
    },
    "trend_ema_long": {
      "fast": 26,
      "medium": 50,
      "long": 120
    },
    "ma_breakout": {
      "enabled": true,
      "ma_type": "sma",
      "ma_periods": [
        7,
        25,
        99
      ],
      "volume_confirm": true,
      "exempt_static_on_volume": false,
      "volume_multiplier": 1.5,
      "exclude_timeframes": []
    },
    "ema_cross": {
      "enabled": true,
      "period": 120,
      "volume_confirm": true,
      "exempt_static_on_volume": true,
      "volume_multiplier": 2,
      "atr_period": 14,
      "atr_multiplier": 1,
      "exclude_timeframes": []
    },
    "kdj_cross": {
      "enabled": false,
      "fast_k": 9,
      "slow_k": 3,
      "slow_d": 3,
      "volume_confirm": true,
      "exempt_static_on_volume": false,
      "volume_multiplier": 2,
      "exclude_timeframes": [
        "1d"
      ]
    },
    "volatility_breakout": {
      "enabled": false,
      "atr_period": 14,
      "atr_multiplier": 2.5,
      "volume_confirm": true,
      "exempt_static_on_volume": false,
      "volume_multiplier": 2.0,
      "exclude_timeframes": []
    },
    "level_breakout": {
      "enabled": true,
      "volume_confirm": false,
      "exempt_static_on_volume": true,
      "volume_multiplier": 1.5,
      "level_detection": {
        "method": "advanced",
        "swing_pivots": {
          "enabled": true,
          "left_bars": 7,
          "right_bars": 7
        },
        "rolling_pivots": {
          "enabled": true
        }
      },
      "breakout_period": 120,
      "volume_ma_period": 20,
      "atr_period": 14,
      "atr_multiplier_breakout": 0.5,
      "exclude_timeframes": [],
      "overrides_by_timeframe": {
        "1d": {
          "level_detection": {
            "method": "advanced",
            "swing_pivots": {
              "enabled": true,
              "left_bars": 10,
              "right_bars": 10
            }
          }
        }
      }
    },
    "rsi_divergence": {
      "enabled": false,
      "rsi_period": 14,
      "lookback_period": 60,
      "exclude_timeframes": [
        "1h"
      ]
    },
    "ob_luxalgo": {
      "enabled": true,
      "swing_length": 5,
      "alert_on_rejection": true,
      "alert_on_breakout": true,
      "exclude_timeframes": []
    },
    "ob_fluxcharts": {
      "enabled": true,
      "swing_length": 10,
      "atr_multiplier": 3.5,
      "alert_on_rejection": true,
      "alert_on_breakout": true,
      "exclude_timeframes": []
    },
    "high_funding_rate": {
      "enabled": true,
      "threshold": 0.01,
      "cooldown_mult": 2,
      "scan_top_n": 500,
      "exclude_timeframes": [
        "15m",
        "1h",
        "1d"
      ]
    },
    "trend_channel_breakout": [
      {
        "name": "短期趋势通道 (1h/4h)",
        "enabled": true,
        "min_trend_length": 10,
        "std_dev_multiplier": 1.2,
        "breakout_confirmation_atr": 0.1,
        "volume_confirm": false,
        "exempt_static_on_volume": true,
        "volume_multiplier": 1.5,
        "exclude_timeframes": [
          "1d"
        ],
        "overrides_by_timeframe": {
          "1h": {
            "lookback_period": 120
          },
          "4h": {
            "lookback_period": 80
          }
        }
      },
      {
        "name": "长期趋势通道 (All TFs)",
        "enabled": true,
        "min_trend_length": 20,
        "std_dev_multiplier": 1.8,
        "breakout_confirmation_atr": 0.2,
        "volume_confirm": false,
        "exempt_static_on_volume": true,
        "volume_multiplier": 2.0,
        "exclude_timeframes": [],
        "overrides_by_timeframe": {
          "1h": {
            "lookback_period": 300
          },
          "4h": {
            "lookback_period": 200
          },
          "1d": {
            "lookback_period": 150
          }
        }
      }
    ],
    "consecutive_candles": {
      "enabled": true,
      "dynamic_count": {
        "enabled": true,
        "method": "linear_stepped",
        "min_count": 6,
        "max_count": 12,
        "apply_to_rank_n": 100,
        "rank_step_size": 10,
        "default_count": 9
      },
      "min_consecutive_candles": 4,
      "volume_confirm": false,
      "exempt_static_on_volume": true,
      "volume_multiplier": 1.5,
      "exclude_timeframes": [
        "15m"
      ]
    }
  },
  "periodic_reports": [
    {
      "enabled": false,
      "report_name": "4小时热点报告",
      "run_interval": "4h",
      "top_n_by_volume": 300,
      "top_n_gainers": 10,
      "min_consecutive_candles": 5,
      "volume_ma_period": 20,
      "top_n_volume_ratio": 10,
      "market_sentiment": {
        "enabled": true,
        "rsi_period": 14,
        "rsi_overbought": 70,
        "rsi_oversold": 30
      }
    },
    {
      "enabled": false,
      "report_name": "每日宏观复盘",
      "run_interval": "1d",
      "top_n_by_volume": 300,
      "top_n_gainers": 10,
      "min_consecutive_candles": 3,
      "volume_ma_period": 20,
      "top_n_volume_ratio": 10,
      "market_sentiment": {
        "enabled": true,
        "rsi_period": 14,
        "rsi_overbought": 75,
        "rsi_oversold": 25
      }
    }
  ],
  "notification_settings": {
    "dingtalk": {
      "enabled": true
    },
    "desktop": {
      "enabled": false,
      "timeout_seconds": 30
    }
  },
  "position_protection": {
    "enabled": true,
    "stop_mode": "moving_averages",
    "ma": {
      "timeframe": "1h",
      "n1_bars": 7,
      "n2_bars": 26,
      "n3_bars": 83,
      "atr_period": 14,
      "atr_buffer_multiplier": 0.30,
      "recovery_atr_buffer_multiplier": 0.30,
      "require_closed_candle": true,
      "require_second_confirmation_for_exit": true
    },
    "tiers": {
      "tier1_ratio": 0.20,
      "tier2_ratio": 0.30,
      "use_risk_cycle_base_position": true,
      "confirm_position_after_execution": true
    },
    "position_state": {
      "detect_manual_position_changes": true,
      "reset_risk_cycle_on_add": true,
      "add_immunity_until_current_candle_close": true,
      "use_position_version": true,
      "cleanup_state_on_manual_close": true,
      "sync_state_on_startup": true
    },
    "execution": {
      "symbol_side_lock": true,
      "require_position_snapshot": true,
      "require_position_version_check": true,
      "confirm_order_execution": true,
      "confirm_position_change": true,
      "retry_on_partial_fill": false
    },
    "emergency": {
      "enabled": true,
      "timeframe": "15m",
      "atr_period": 14,
      "atr_multiplier": 3.0,
      "structure_lookback": 4,
      "require_second_confirmation": true,
      "confirmation_delay_sec": 1.0,
      "require_double_price_source": true,
      "max_price_source_difference_pct": 0.003,
      "require_fresh_data": true
    },
    "hard_stop": {
      "enabled": true,
      "timeframe": "1h",
      "atr_period": 14,
      "atr_multiplier": 6.0,
      "minimum_distance_pct": 0.05,
      "recreate_if_missing": true,
      "only_manage_program_orders": true,
      "cleanup_when_position_closed": true,
      "sync_on_position_change": true
    },
    "api_protection": {
      "enabled": true,
      "max_retries": 5,
      "retry_initial_delay_sec": 1.0,
      "retry_max_delay_sec": 30.0,
      "retry_jitter_pct": 0.20,
      "failure_threshold": 5,
      "circuit_breaker_cooldown_sec": 30,
      "enable_request_priority": true,
      "positions_cache_ttl_sec": 5,
      "ticker_cache_ttl_sec": 2,
      "orders_cache_ttl_sec": 5,
      "ohlcv_cache_enabled": true
    },
    "websocket": {
      "enabled": true,
      "single_subscription_per_symbol": true,
      "stale_timeout_sec": 30,
      "reconnect_enabled": true,
      "reconnect_initial_sec": 1,
      "reconnect_max_sec": 60,
      "reconnect_jitter_pct": 0.20,
      "fallback_to_rest_when_stale": true,
      "resync_after_reconnect": true
    },
    "safe_mode": {
      "enabled": true,
      "on_api_failure": true,
      "on_ws_and_rest_failure": true,
      "block_trading_on_stale_data": true
    },
    "state": {
      "persistence_enabled": true,
      "file": "position_protection_state.json",
      "sync_on_startup": true
    },
    "data_validation": {
      "require_sufficient_ohlcv": true,
      "minimum_ohlcv_candles": 100,
      "reject_stale_market_data": true,
      "reject_single_source_price_anomaly": true
    },
    "logging": {
      "log_position_changes": true,
      "log_execution": true,
      "log_api_rate_limit": true,
      "log_ws_reconnect": true,
      "log_safe_mode": true
    }
  }
}